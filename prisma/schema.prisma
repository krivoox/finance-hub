generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Better Auth models
// ============================================================================

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Finance Hub profile extensions
  displayName        String?
  preferredCurrency  String  @default("ARS")
  timezone           String  @default("America/Argentina/Buenos_Aires")

  sessions           Session[]
  accounts           Account[]
  memberships        Membership[]
  splitGroupMembers  SplitGroupMember[]

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ============================================================================
// Finance Hub domain
// ============================================================================

enum WorkspaceType {
  personal
}

enum MembershipRole {
  owner
  admin
  member
  viewer
}

enum CategoryKind {
  income
  expense
}

enum AccountType {
  checking
  savings
  cash
  credit_card
  virtual_wallet
  other
}

enum TransactionType {
  income
  expense
  transfer
  fx_debit
  fx_credit
}

enum GoalKind {
  save
  debt_payoff
}

enum GoalStatus {
  active
  completed
  cancelled
}

enum BudgetPeriod {
  monthly
  weekly
  custom
}

enum SplitMethod {
  equal
  percentage
  exact
}

enum SplitGroupKind {
  ongoing
  one_time
}

enum SplitMemberKind {
  user
  ghost
}

enum RecurringFrequency {
  weekly
  biweekly
  monthly
  yearly
}

enum RecurringRuleStatus {
  active
  paused
  ended
}

enum RecurringPausedReason {
  manual
  account_archived
}

model Workspace {
  id           String        @id @default(cuid())
  name         String
  type         WorkspaceType @default(personal)
  baseCurrency String        @default("ARS")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  memberships          Membership[]
  categories           Category[]
  financeAccounts      FinanceAccount[]
  transactions         Transaction[]
  budgets              Budget[]
  goals                Goal[]
  splitGroups          SplitGroup[]
  currencyExchanges    CurrencyExchange[]
  consolidationRate    WorkspaceConsolidationRate?
  recurringRules       RecurringRule[]

  @@map("workspace")
}

model Membership {
  id          String         @id @default(cuid())
  workspaceId String
  userId      String
  role        MembershipRole @default(member)
  joinedAt    DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("membership")
}

// SPEC-04 — Categories classify incomes/expenses within a workspace.
// Uniqueness (workspaceId + kind + lower(name) among non-archived) is enforced
// by the domain layer (case-insensitive) rather than a DB constraint because
// Postgres has no built-in case-insensitive unique index without an expression.
model Category {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  kind        CategoryKind
  parentId    String?
  isArchived  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent         Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[]       @relation("CategoryTree")
  transactions   Transaction[]
  budgets        BudgetCategory[]
  recurringRules RecurringRule[]

  @@index([workspaceId, kind])
  @@index([workspaceId, isArchived])
  @@index([parentId])
  @@map("category")
}

// SPEC-03 — Financial accounts (banks, wallets, cash, credit cards). Named
// `FinanceAccount` at the Prisma layer to avoid clashing with Better Auth's
// own `Account` model; the app-domain name remains "Account".
model FinanceAccount {
  id                  String      @id @default(cuid())
  workspaceId         String
  name                String
  type                AccountType
  currency            String
  initialBalanceCents Int         @default(0)
  creditLimitCents    Int?
  isArchived          Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  workspace              Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions           Transaction[]      @relation("TxAccount")
  incomingTransfers      Transaction[]      @relation("TxCounterparty")
  linkedGoals            Goal[]             @relation("GoalLinkedAccount")
  exchangesFrom          CurrencyExchange[] @relation("ExchangeFromAccount")
  exchangesTo            CurrencyExchange[] @relation("ExchangeToAccount")
  recurringAsAccount     RecurringRule[]    @relation("RecurringAccount")
  recurringAsCounterparty RecurringRule[]   @relation("RecurringCounterparty")

  @@index([workspaceId, isArchived])
  @@index([workspaceId, type])
  @@map("finance_account")
}

// SPEC-05 / SPEC-06 — Ledger movements (income, expense, transfer).
// `amountCents` is always positive; direction is expressed by `type` and the
// (accountId, counterpartyAccountId) pair.
//
// Transfers have `counterpartyAccountId` set (destination) and `categoryId`
// null. Income/expense have `categoryId` set and no counterparty.
model Transaction {
  id                    String          @id @default(cuid())
  workspaceId           String
  type                  TransactionType
  amountCents           Int
  currency              String
  occurredOn            DateTime        @db.Date
  description           String?
  categoryId            String?
  accountId             String
  counterpartyAccountId String?
  createdByUserId       String
  recurringRuleId       String?
  scheduledOn           DateTime?       @db.Date
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  workspace           Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category            Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account             FinanceAccount  @relation("TxAccount", fields: [accountId], references: [id], onDelete: Restrict)
  counterpartyAccount FinanceAccount? @relation("TxCounterparty", fields: [counterpartyAccountId], references: [id], onDelete: Restrict)
  recurringRule              RecurringRule?      @relation(fields: [recurringRuleId], references: [id], onDelete: Restrict)
  expenseSplit               ExpenseSplit?
  currencyExchangeAsFrom     CurrencyExchange?   @relation("ExchangeFromTx")
  currencyExchangeAsTo       CurrencyExchange?   @relation("ExchangeToTx")
  goalContribution           GoalContribution?

  @@unique([recurringRuleId, scheduledOn])
  @@index([workspaceId, occurredOn, createdAt])
  @@index([workspaceId, type, occurredOn, createdAt])
  @@index([accountId])
  @@index([counterpartyAccountId])
  @@index([categoryId])
  @@index([recurringRuleId])
  @@map("transaction")
}

// SPEC-18 — Recurring transaction templates (not ledger entries until materialized).
model RecurringRule {
  id                    String                 @id @default(cuid())
  workspaceId           String
  name                  String
  type                  TransactionType
  amountCents           Int
  currency              String
  accountId             String
  counterpartyAccountId String?
  categoryId            String?
  description           String?
  frequency             RecurringFrequency
  startDate             DateTime               @db.Date
  endDate               DateTime?              @db.Date
  status                RecurringRuleStatus    @default(active)
  pausedReason          RecurringPausedReason?
  createdByUserId       String
  endedAt               DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  workspace           Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account             FinanceAccount  @relation("RecurringAccount", fields: [accountId], references: [id], onDelete: Restrict)
  counterpartyAccount FinanceAccount? @relation("RecurringCounterparty", fields: [counterpartyAccountId], references: [id], onDelete: Restrict)
  category            Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions        Transaction[]

  @@index([workspaceId, status])
  @@index([workspaceId, type])
  @@index([accountId])
  @@index([counterpartyAccountId])
  @@map("recurring_rule")
}

// SPEC-16 — Currency exchange (ARS↔USD) within one workspace: two linked txs.
model CurrencyExchange {
  id                String   @id @default(cuid())
  workspaceId       String
  fromAccountId     String
  toAccountId       String
  fromAmountCents   Int
  toAmountCents     Int
  occurredOn        DateTime @db.Date
  description       String?
  createdByUserId   String
  fromTransactionId String   @unique
  toTransactionId   String   @unique
  createdAt         DateTime @default(now())

  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromAccount     FinanceAccount @relation("ExchangeFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount       FinanceAccount @relation("ExchangeToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  fromTransaction Transaction    @relation("ExchangeFromTx", fields: [fromTransactionId], references: [id], onDelete: Cascade)
  toTransaction   Transaction    @relation("ExchangeToTx", fields: [toTransactionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, occurredOn])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("currency_exchange")
}

// ADR-006 / SPEC-12 — Manual consolidation rate for ≈ net worth (one per workspace).
model WorkspaceConsolidationRate {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  quoteCurrency   String
  /// How many base major units per 1 quote major unit, scaled by `scale`
  /// (default 1e6). Example: 1 USD = 1400 ARS → rateScaled = 1_400_000_000.
  rateScaled      Int
  scale           Int      @default(1000000)
  label           String
  asOf            DateTime
  updatedByUserId String
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_consolidation_rate")
}

// SPEC-19 — Global daily USD quotes (DolarApi). Not workspace-scoped.
model UsdQuoteSnapshot {
  id          String   @id @default(cuid())
  /// Calendar day in America/Argentina/Buenos_Aires (UTC midnight Date).
  asOfDate    DateTime @unique @db.Date
  fetchedAt   DateTime
  provider    String   @default("dolarapi")
  providerUrl String
  createdAt   DateTime @default(now())

  lines UsdQuoteLine[]

  @@map("usd_quote_snapshot")
}

model UsdQuoteLine {
  id                 String   @id @default(cuid())
  snapshotId         String
  /// Provider casa: oficial | bolsa (MEP) | tarjeta | …
  casa               String
  nombre             String
  buyRateScaled      Int
  sellRateScaled     Int
  scale              Int      @default(1000000)
  providerUpdatedAt  DateTime

  snapshot UsdQuoteSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, casa])
  @@index([casa])
  @@map("usd_quote_line")
}

// SPEC-07 — Budgets cap spending on one or more expense categories within a
// period. `spent` is derived from Transactions and computed at read time.
//
// `startDate` anchors the period. For `monthly`/`weekly` budgets the current
// period is derived from `startDate` and the request date. For `custom`,
// `endDate` is required and the period is [startDate, endDate] inclusive.
//
// `categoryIds` empty (no BudgetCategory rows) means "all expense categories".
model Budget {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  period      BudgetPeriod
  startDate   DateTime     @db.Date
  endDate     DateTime?    @db.Date
  limitCents  Int
  currency    String
  isArchived  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  categories BudgetCategory[]

  @@index([workspaceId, isArchived])
  @@map("budget")
}

// Join table between Budget and Category (many-to-many). No metadata beyond
// the pair; deleting a budget cascades, deleting a referenced category is
// restricted because history must survive.
model BudgetCategory {
  budgetId   String
  categoryId String

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([budgetId, categoryId])
  @@index([categoryId])
  @@map("budget_category")
}

// SPEC-08 — Savings and debt-payoff goals with tracked progress.
//
// `currentAmountCents` is the sum of contributions and is denormalized on
// the Goal row for cheap reads and simple auto-complete transitions.
// Each contribution (H4) materializes a transfer Transaction toward
// `linkedAccountId` (see GoalContribution.transactionId).
//
// `linkedAccountId` is optional at create — required to contribute (destination
// of the transfer). An emergency fund may link to a savings account; a
// debt-payoff goal may link to the credit card being paid off. The
// FinanceAccount relation is `Restrict` on delete so archived goals keep
// their reference.
model Goal {
  id                 String     @id @default(cuid())
  workspaceId        String
  name               String
  kind               GoalKind
  targetAmountCents  Int
  currentAmountCents Int        @default(0)
  currency           String
  targetDate         DateTime?  @db.Date
  linkedAccountId    String?
  status             GoalStatus @default(active)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  linkedAccount FinanceAccount?    @relation("GoalLinkedAccount", fields: [linkedAccountId], references: [id], onDelete: Restrict)
  contributions GoalContribution[]

  @@index([workspaceId, status])
  @@index([linkedAccountId])
  @@map("goal")
}

// SPEC-08 H4 — Contribution event towards a Goal, always linked 1:1 to a
// transfer Transaction. Rows are immutable except cascade undo when the
// transfer is deleted (restores Goal.currentAmount / status).
model GoalContribution {
  id              String   @id @default(cuid())
  goalId          String
  amountCents     Int
  contributedOn   DateTime @db.Date
  note            String?
  createdByUserId String
  transactionId   String   @unique
  createdAt       DateTime @default(now())

  goal        Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([goalId, contributedOn])
  @@map("goal_contribution")
}

// SPEC-09 / SPEC-10 — SplitGroup is a circle of IOUs on a personal workspace.
// The linked expense Transaction may live in another member's personal tenant.
model SplitGroup {
  id               String         @id @default(cuid())
  workspaceId      String
  name             String
  kind             SplitGroupKind
  currency         String
  publicShareToken String         @unique
  createdByUserId  String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     SplitGroupMember[]
  splits      ExpenseSplit[]
  settlements Settlement[]

  @@index([workspaceId])
  @@index([createdByUserId])
  @@map("split_group")
}

model SplitGroupMember {
  id             String          @id @default(cuid())
  splitGroupId   String
  kind           SplitMemberKind
  userId         String?
  displayName    String
  /// lower(trim(displayName)); only ghosts (users stay null so UNIQUE allows many NULLs)
  displayNameKey String?
  createdAt      DateTime        @default(now())

  splitGroup SplitGroup @relation(fields: [splitGroupId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: Restrict)

  paidSplits      ExpenseSplit[]      @relation("SplitPaidBy")
  shares          ExpenseSplitShare[]
  settlementsFrom Settlement[]        @relation("SettlementFrom")
  settlementsTo   Settlement[]        @relation("SettlementTo")

  @@unique([splitGroupId, userId])
  @@unique([splitGroupId, displayNameKey])
  @@index([userId])
  @@map("split_group_member")
}

model ExpenseSplit {
  id                   String      @id @default(cuid())
  splitGroupId         String
  expenseTransactionId String      @unique
  paidByMemberId       String
  method               SplitMethod
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  splitGroup SplitGroup         @relation(fields: [splitGroupId], references: [id], onDelete: Cascade)
  expense    Transaction        @relation(fields: [expenseTransactionId], references: [id], onDelete: Cascade)
  paidBy     SplitGroupMember   @relation("SplitPaidBy", fields: [paidByMemberId], references: [id], onDelete: Restrict)
  shares     ExpenseSplitShare[]

  @@index([splitGroupId])
  @@index([paidByMemberId])
  @@map("expense_split")
}

model ExpenseSplitShare {
  id         String @id @default(cuid())
  splitId    String
  memberId   String
  shareCents Int

  split  ExpenseSplit     @relation(fields: [splitId], references: [id], onDelete: Cascade)
  member SplitGroupMember @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([splitId, memberId])
  @@index([memberId])
  @@map("expense_split_share")
}

// SPEC-10 — Settlement between two SplitGroup members reduces net IOU.
model Settlement {
  id              String   @id @default(cuid())
  splitGroupId    String
  fromMemberId    String
  toMemberId      String
  amountCents     Int
  occurredOn      DateTime @db.Date
  note            String?
  createdByUserId String
  createdAt       DateTime @default(now())

  splitGroup SplitGroup       @relation(fields: [splitGroupId], references: [id], onDelete: Cascade)
  fromMember SplitGroupMember @relation("SettlementFrom", fields: [fromMemberId], references: [id], onDelete: Restrict)
  toMember   SplitGroupMember @relation("SettlementTo", fields: [toMemberId], references: [id], onDelete: Restrict)

  @@index([splitGroupId, occurredOn])
  @@map("settlement")
}
